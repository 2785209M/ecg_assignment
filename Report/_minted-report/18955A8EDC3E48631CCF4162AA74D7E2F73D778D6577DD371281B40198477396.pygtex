\PYG{n}{stop\PYGZus{}Hz} \PYG{o}{=} \PYG{p}{[(}\PYG{l+m+mi}{0}\PYG{p}{,} \PYG{l+m+mi}{1}\PYG{p}{),} \PYG{p}{(}\PYG{l+m+mi}{45}\PYG{p}{,} \PYG{n}{sample\PYGZus{}rate} \PYG{o}{//} \PYG{l+m+mi}{2}\PYG{p}{)]} \PYG{c+c1}{\PYGZsh{} The cutoff frequency for the filter}
