\begin{Verbatim}[commandchars=\\\{\}]
\PYG{k+kn}{import} \PYG{n+nn}{fir\PYGZus{}design} \PYG{k}{as} \PYG{n+nn}{fir\PYGZus{}design}
\PYG{k+kn}{import} \PYG{n+nn}{fir\PYGZus{}filter} \PYG{k}{as} \PYG{n+nn}{fir\PYGZus{}filter}
\PYG{k+kn}{import} \PYG{n+nn}{numpy} \PYG{k}{as} \PYG{n+nn}{np}
\PYG{k+kn}{import} \PYG{n+nn}{matplotlib.pyplot} \PYG{k}{as} \PYG{n+nn}{plt}
\PYG{k+kn}{from} \PYG{n+nn}{pathlib} \PYG{k+kn}{import} \PYG{n}{Path}

\PYG{n}{IMAGES} \PYG{o}{=} \PYG{n}{Path}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}images\PYGZdq{}}\PYG{p}{)}
\PYG{n}{IMAGES}\PYG{o}{.}\PYG{n}{mkdir}\PYG{p}{(}\PYG{n}{parents} \PYG{o}{=} \PYG{k+kc}{True}\PYG{p}{,} \PYG{n}{exist\PYGZus{}ok} \PYG{o}{=} \PYG{k+kc}{True}\PYG{p}{)}

\PYG{n}{tsv} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{loadtxt}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}James\PYGZus{}ecg\PYGZus{}1.tsv\PYGZdq{}}\PYG{p}{,} \PYG{n}{delimiter}\PYG{o}{=}\PYG{l+s+s1}{\PYGZsq{}}\PYG{l+s+se}{\PYGZbs{}t}\PYG{l+s+s1}{\PYGZsq{}}\PYG{p}{)}
\PYG{n}{ecg\PYGZus{}signal} \PYG{o}{=} \PYG{n}{tsv}\PYG{p}{[:,}\PYG{l+m+mi}{8}\PYG{p}{]}\PYG{o}{.}\PYG{n}{copy}\PYG{p}{()}

\PYG{c+c1}{\PYGZsh{} This data is not used for the adaptive filtering, but allows us to call getTaps to get the number of taps for the adaptive filter.}
\PYG{c+c1}{\PYGZsh{} The adaptive filter will be initialized with all coefficients set to zero.}
\PYG{n}{num\PYGZus{}samples} \PYG{o}{=} \PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{ecg\PYGZus{}signal}\PYG{p}{)} \PYG{c+c1}{\PYGZsh{} Number of Samples in ECG signal}
\PYG{n}{sample\PYGZus{}rate} \PYG{o}{=} \PYG{l+m+mi}{250} \PYG{c+c1}{\PYGZsh{} Sampling rate of ECG signal (Hz)}
\PYG{n}{width} \PYG{o}{=} \PYG{l+m+mi}{1} \PYG{c+c1}{\PYGZsh{} desired width of the transition window}
\PYG{n}{nyquist\PYGZus{}freq} \PYG{o}{=} \PYG{n}{sample\PYGZus{}rate} \PYG{o}{//} \PYG{l+m+mi}{2}
\PYG{n}{stop\PYGZus{}Hz} \PYG{o}{=} \PYG{p}{[(}\PYG{l+m+mi}{0}\PYG{p}{,} \PYG{l+m+mi}{1}\PYG{p}{),} \PYG{p}{(}\PYG{l+m+mi}{45}\PYG{p}{,} \PYG{n}{nyquist\PYGZus{}freq}\PYG{p}{)]} \PYG{c+c1}{\PYGZsh{} The cutoff frequency for the filter}
\PYG{n}{A} \PYG{o}{=} \PYG{l+m+mi}{30} \PYG{c+c1}{\PYGZsh{} stopband attenuation}

\PYG{c+c1}{\PYGZsh{} get the number of taps (taps == coefficients).}
\PYG{n}{taps}\PYG{p}{,} \PYG{n}{num\PYGZus{}taps} \PYG{o}{=} \PYG{n}{fir\PYGZus{}design}\PYG{o}{.}\PYG{n}{getTaps}\PYG{p}{(}\PYG{n}{sample\PYGZus{}rate}\PYG{p}{,} \PYG{n}{stop\PYGZus{}Hz}\PYG{p}{,} \PYG{n}{A}\PYG{p}{,} \PYG{n}{width}\PYG{p}{)}

\PYG{c+c1}{\PYGZsh{}Simulate realtime adaptive filtering of the ECG}

\PYG{c+c1}{\PYGZsh{} Initialize adaptive filter with num\PYGZus{}taps coefficients all set to zero}
\PYG{n}{adaptivefilter} \PYG{o}{=} \PYG{n}{fir\PYGZus{}filter}\PYG{o}{.}\PYG{n}{FIRfilter}\PYG{p}{(}\PYG{n}{np}\PYG{o}{.}\PYG{n}{zeros}\PYG{p}{(}\PYG{n}{num\PYGZus{}taps}\PYG{p}{))}

\PYG{c+c1}{\PYGZsh{} Initialize an array to hold the adaptive filtered ECG signal}
\PYG{n}{adaptive\PYGZus{}filtered\PYGZus{}ecg\PYGZus{}signal} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{zeros}\PYG{p}{(}\PYG{n}{num\PYGZus{}samples}\PYG{p}{)}

\PYG{c+c1}{\PYGZsh{} Use 50Hz + DC shift as the signal for adaptive filtering (to be filtered out)}
\PYG{n}{fiftyHz} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{sin}\PYG{p}{(}\PYG{l+m+mi}{2} \PYG{o}{*} \PYG{n}{np}\PYG{o}{.}\PYG{n}{pi} \PYG{o}{*} \PYG{l+m+mi}{50} \PYG{o}{/} \PYG{n}{sample\PYGZus{}rate} \PYG{o}{*} \PYG{n}{np}\PYG{o}{.}\PYG{n}{arange}\PYG{p}{(}\PYG{n}{num\PYGZus{}samples}\PYG{p}{))} \PYG{o}{+} \PYG{l+m+mf}{0.3}

\PYG{c+c1}{\PYGZsh{} Use the filtered ECG signal as the noise reference for adaptive filtering}
\PYG{k}{for} \PYG{n}{i} \PYG{o+ow}{in} \PYG{n+nb}{range}\PYG{p}{(}\PYG{n}{num\PYGZus{}samples}\PYG{p}{):}
    \PYG{n}{adaptive\PYGZus{}filtered\PYGZus{}ecg\PYGZus{}signal}\PYG{p}{[}\PYG{n}{i}\PYG{p}{]} \PYG{o}{=} \PYG{n}{adaptivefilter}\PYG{o}{.}\PYG{n}{dofilteradaptive}\PYG{p}{(}\PYG{n}{fiftyHz}\PYG{p}{[}\PYG{n}{i}\PYG{p}{],} \PYG{n}{ecg\PYGZus{}signal}\PYG{p}{[}\PYG{n}{i}\PYG{p}{],} \PYG{n}{learningRate}\PYG{o}{=}\PYG{l+m+mf}{0.001}\PYG{p}{)}

\PYG{n}{measurement\PYGZus{}time} \PYG{o}{=} \PYG{n}{num\PYGZus{}samples} \PYG{o}{/} \PYG{n}{sample\PYGZus{}rate}
\PYG{n}{t} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{linspace}\PYG{p}{(}\PYG{l+m+mi}{0} \PYG{p}{,} \PYG{n}{measurement\PYGZus{}time} \PYG{p}{,} \PYG{n}{num\PYGZus{}samples}\PYG{p}{)}

\PYG{n}{plt}\PYG{o}{.}\PYG{n}{figure}\PYG{p}{()}
\PYG{n}{plt}\PYG{o}{.}\PYG{n}{title}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}ecg\PYGZus{}adaptive\PYGZus{}filtered\PYGZus{}time\PYGZus{}domain\PYGZdq{}}\PYG{p}{)}
\PYG{n}{plt}\PYG{o}{.}\PYG{n}{plot}\PYG{p}{(}\PYG{n}{t}\PYG{p}{[}\PYG{l+m+mi}{0}\PYG{p}{:}\PYG{l+m+mi}{1000}\PYG{p}{],} \PYG{n}{adaptive\PYGZus{}filtered\PYGZus{}ecg\PYGZus{}signal}\PYG{p}{[}\PYG{l+m+mi}{0}\PYG{p}{:}\PYG{l+m+mi}{1000}\PYG{p}{])}
\PYG{n}{plt}\PYG{o}{.}\PYG{n}{savefig}\PYG{p}{(}\PYG{n}{IMAGES} \PYG{o}{/} \PYG{l+s+s2}{\PYGZdq{}ecg\PYGZus{}adaptive\PYGZus{}filtered\PYGZus{}time\PYGZus{}domain.svg\PYGZdq{}}\PYG{p}{)}
\PYG{n}{plt}\PYG{o}{.}\PYG{n}{show}\PYG{p}{()}
\end{Verbatim}
