\begin{Verbatim}[commandchars=\\\{\}]
\PYG{k+kn}{import} \PYG{n+nn}{fir\PYGZus{}design} \PYG{k}{as} \PYG{n+nn}{fd}
\PYG{k+kn}{import} \PYG{n+nn}{fir\PYGZus{}filter} \PYG{k}{as} \PYG{n+nn}{ff}
\PYG{k+kn}{import} \PYG{n+nn}{numpy} \PYG{k}{as} \PYG{n+nn}{np}
\PYG{k+kn}{import} \PYG{n+nn}{matplotlib.pyplot} \PYG{k}{as} \PYG{n+nn}{plt}
\PYG{k+kn}{from} \PYG{n+nn}{pathlib} \PYG{k+kn}{import} \PYG{n}{Path}

\PYG{n}{IMAGES} \PYG{o}{=} \PYG{n}{Path}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}images\PYGZdq{}}\PYG{p}{)}
\PYG{n}{IMAGES}\PYG{o}{.}\PYG{n}{mkdir}\PYG{p}{(}\PYG{n}{parents} \PYG{o}{=} \PYG{k+kc}{True}\PYG{p}{,} \PYG{n}{exist\PYGZus{}ok} \PYG{o}{=} \PYG{k+kc}{True}\PYG{p}{)}

\PYG{n}{tsv1} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{loadtxt}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}James\PYGZus{}ecg\PYGZus{}1.tsv\PYGZdq{}}\PYG{p}{,} \PYG{n}{delimiter}\PYG{o}{=}\PYG{l+s+s1}{\PYGZsq{}}\PYG{l+s+se}{\PYGZbs{}t}\PYG{l+s+s1}{\PYGZsq{}}\PYG{p}{)}
\PYG{n}{ecg\PYGZus{}signal} \PYG{o}{=} \PYG{n}{tsv1}\PYG{p}{[:,}\PYG{l+m+mi}{8}\PYG{p}{]}\PYG{o}{.}\PYG{n}{copy}\PYG{p}{()}

\PYG{c+c1}{\PYGZsh{} Performing FIR Pre\PYGZhy{}Filtering to remove DC offset, baseline wander, and 50Hz mains interference}

\PYG{n}{num\PYGZus{}samples} \PYG{o}{=} \PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{ecg\PYGZus{}signal}\PYG{p}{)} \PYG{c+c1}{\PYGZsh{} Number of Samples in ECG signal}
\PYG{n}{sample\PYGZus{}rate} \PYG{o}{=} \PYG{l+m+mi}{250} \PYG{c+c1}{\PYGZsh{} Sampling rate of ECG signal (Hz)}
\PYG{n}{width} \PYG{o}{=} \PYG{l+m+mi}{1} \PYG{c+c1}{\PYGZsh{} desired width of the transition window}
\PYG{n}{stop\PYGZus{}Hz} \PYG{o}{=} \PYG{p}{[(}\PYG{l+m+mi}{0}\PYG{p}{,} \PYG{l+m+mi}{3}\PYG{p}{),} \PYG{p}{(}\PYG{l+m+mi}{40}\PYG{p}{,} \PYG{n}{sample\PYGZus{}rate} \PYG{o}{//} \PYG{l+m+mi}{2}\PYG{p}{)]} \PYG{c+c1}{\PYGZsh{} The cutoff frequency for the filter}
\PYG{n}{A} \PYG{o}{=} \PYG{l+m+mi}{30} \PYG{c+c1}{\PYGZsh{} stopband attenuation}

\PYG{c+c1}{\PYGZsh{} get the array of taps and number of taps (taps == coefficients)}
\PYG{n}{taps}\PYG{p}{,} \PYG{n}{num\PYGZus{}taps} \PYG{o}{=} \PYG{n}{fd}\PYG{o}{.}\PYG{n}{getTaps}\PYG{p}{(}\PYG{n}{sample\PYGZus{}rate}\PYG{p}{,} \PYG{n}{stop\PYGZus{}Hz}\PYG{p}{,} \PYG{n}{A}\PYG{p}{,} \PYG{n}{width}\PYG{p}{)}

\PYG{c+c1}{\PYGZsh{} use FIRfilter to filter x with the FIR filter}
\PYG{n}{prefilter} \PYG{o}{=} \PYG{n}{ff}\PYG{o}{.}\PYG{n}{FIRfilter}\PYG{p}{(}\PYG{n}{taps}\PYG{p}{)}

\PYG{c+c1}{\PYGZsh{} Simulate realtime filtering of the ECG}
\PYG{n}{filtered\PYGZus{}ecg\PYGZus{}signal} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{zeros}\PYG{p}{(}\PYG{n}{num\PYGZus{}samples}\PYG{p}{)}
\PYG{k}{for} \PYG{n}{i} \PYG{o+ow}{in} \PYG{n+nb}{range}\PYG{p}{(}\PYG{n}{num\PYGZus{}samples}\PYG{p}{):}
    \PYG{n}{filtered\PYGZus{}ecg\PYGZus{}signal}\PYG{p}{[}\PYG{n}{i}\PYG{p}{]} \PYG{o}{=} \PYG{n}{prefilter}\PYG{o}{.}\PYG{n}{dofilter}\PYG{p}{(}\PYG{n}{ecg\PYGZus{}signal}\PYG{p}{[}\PYG{n}{i}\PYG{p}{])}

\PYG{n}{tsv2} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{loadtxt}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}Ewan\PYGZus{}ecg\PYGZus{}1.tsv\PYGZdq{}}\PYG{p}{,} \PYG{n}{delimiter}\PYG{o}{=}\PYG{l+s+s1}{\PYGZsq{}}\PYG{l+s+se}{\PYGZbs{}t}\PYG{l+s+s1}{\PYGZsq{}}\PYG{p}{)}
\PYG{n}{ecg\PYGZus{}template} \PYG{o}{=} \PYG{n}{tsv2}\PYG{p}{[:,}\PYG{l+m+mi}{8}\PYG{p}{]}\PYG{o}{.}\PYG{n}{copy}\PYG{p}{()}

\PYG{c+c1}{\PYGZsh{} use new prefilter to filter the ECG template signal. So delay line is empty}
\PYG{n}{prefilter2} \PYG{o}{=} \PYG{n}{ff}\PYG{o}{.}\PYG{n}{FIRfilter}\PYG{p}{(}\PYG{n}{taps}\PYG{p}{)}

\PYG{c+c1}{\PYGZsh{} Simulate realtime filtering of the ECG template}
\PYG{n}{filtered\PYGZus{}ecg\PYGZus{}template} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{zeros}\PYG{p}{(}\PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{ecg\PYGZus{}template}\PYG{p}{))}
\PYG{k}{for} \PYG{n}{i} \PYG{o+ow}{in} \PYG{n+nb}{range}\PYG{p}{(}\PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{ecg\PYGZus{}template}\PYG{p}{)):}
    \PYG{n}{filtered\PYGZus{}ecg\PYGZus{}template}\PYG{p}{[}\PYG{n}{i}\PYG{p}{]} \PYG{o}{=} \PYG{n}{prefilter2}\PYG{o}{.}\PYG{n}{dofilter}\PYG{p}{(}\PYG{n}{ecg\PYGZus{}template}\PYG{p}{[}\PYG{n}{i}\PYG{p}{])}

\PYG{c+c1}{\PYGZsh{}extract one PQRST complex from the filtered ECG template for matching}
\PYG{n}{filtered\PYGZus{}ecg\PYGZus{}template} \PYG{o}{=} \PYG{n}{filtered\PYGZus{}ecg\PYGZus{}template}\PYG{p}{[}\PYG{l+m+mi}{500}\PYG{p}{:}\PYG{l+m+mi}{700}\PYG{p}{]}

\PYG{c+c1}{\PYGZsh{} Reverse the filtered ECG template for cross\PYGZhy{}correlation}
\PYG{n}{filtered\PYGZus{}ecg\PYGZus{}template} \PYG{o}{=} \PYG{n}{filtered\PYGZus{}ecg\PYGZus{}template}\PYG{p}{[::}\PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{]}

\PYG{n}{matched\PYGZus{}filter} \PYG{o}{=} \PYG{n}{ff}\PYG{o}{.}\PYG{n}{FIRfilter}\PYG{p}{(}\PYG{n}{filtered\PYGZus{}ecg\PYGZus{}template}\PYG{p}{)}

\PYG{n}{matched\PYGZus{}filtered\PYGZus{}ecg\PYGZus{}signal} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{zeros}\PYG{p}{(}\PYG{n}{num\PYGZus{}samples}\PYG{p}{)}

\PYG{n}{num\PYGZus{}samples\PYGZus{}template} \PYG{o}{=} \PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{matched\PYGZus{}filtered\PYGZus{}ecg\PYGZus{}signal}\PYG{p}{)} \PYG{c+c1}{\PYGZsh{} Number of Samples in ECG signal}
\PYG{n}{measurement\PYGZus{}time} \PYG{o}{=} \PYG{n}{num\PYGZus{}samples\PYGZus{}template} \PYG{o}{/} \PYG{n}{sample\PYGZus{}rate}
\PYG{n}{t2} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{linspace}\PYG{p}{(}\PYG{l+m+mi}{0} \PYG{p}{,} \PYG{n}{measurement\PYGZus{}time} \PYG{p}{,} \PYG{n}{num\PYGZus{}samples\PYGZus{}template}\PYG{p}{)}

\PYG{c+c1}{\PYGZsh{}Realtime matched filtering of the filtered ECG signal with the filtered ECG template}
\PYG{n}{last\PYGZus{}peak\PYGZus{}index} \PYG{o}{=} \PYG{l+m+mi}{0}
\PYG{n}{current\PYGZus{}peak\PYGZus{}index} \PYG{o}{=} \PYG{l+m+mi}{0}
\PYG{n}{heartrate} \PYG{o}{=} \PYG{p}{[]}
\PYG{n}{cooldown\PYGZus{}period} \PYG{o}{=} \PYG{l+m+mi}{68}  \PYG{c+c1}{\PYGZsh{} 68/250Hz \PYGZhy{} limits heartrate to 220bpm}
\PYG{n}{threshold} \PYG{o}{=} \PYG{l+m+mi}{3}\PYG{o}{*}\PYG{l+m+mi}{10}\PYG{o}{**\PYGZhy{}}\PYG{l+m+mi}{11}

\PYG{n}{cooldown} \PYG{o}{=} \PYG{l+m+mi}{0}
\PYG{k}{for} \PYG{n}{i} \PYG{o+ow}{in} \PYG{n+nb}{range}\PYG{p}{(}\PYG{n}{num\PYGZus{}samples}\PYG{p}{):}
    \PYG{n}{matched\PYGZus{}filtered\PYGZus{}ecg\PYGZus{}signal}\PYG{p}{[}\PYG{n}{i}\PYG{p}{]} \PYG{o}{=} \PYG{n}{matched\PYGZus{}filter}\PYG{o}{.}\PYG{n}{dofilter}\PYG{p}{(}\PYG{n}{filtered\PYGZus{}ecg\PYGZus{}signal}\PYG{p}{[}\PYG{n}{i}\PYG{p}{])}

    \PYG{c+c1}{\PYGZsh{} Square the matched filtered signal to enhance the peaks for easier detection of R\PYGZhy{}peaks}
    \PYG{n}{matched\PYGZus{}filtered\PYGZus{}ecg\PYGZus{}signal}\PYG{p}{[}\PYG{n}{i}\PYG{p}{]} \PYG{o}{=} \PYG{n}{matched\PYGZus{}filtered\PYGZus{}ecg\PYGZus{}signal}\PYG{p}{[}\PYG{n}{i}\PYG{p}{]} \PYG{o}{*} \PYG{n}{matched\PYGZus{}filtered\PYGZus{}ecg\PYGZus{}signal}\PYG{p}{[}\PYG{n}{i}\PYG{p}{]}

    \PYG{k}{if} \PYG{n}{cooldown} \PYG{o}{\PYGZgt{}} \PYG{l+m+mi}{0}\PYG{p}{:}
        \PYG{n}{cooldown} \PYG{o}{\PYGZhy{}=} \PYG{l+m+mi}{1}

    \PYG{k}{elif} \PYG{n}{matched\PYGZus{}filtered\PYGZus{}ecg\PYGZus{}signal}\PYG{p}{[}\PYG{n}{i}\PYG{p}{]} \PYG{o}{\PYGZgt{}} \PYG{n}{threshold}\PYG{p}{:}
        \PYG{n}{last\PYGZus{}peak\PYGZus{}index} \PYG{o}{=} \PYG{n}{current\PYGZus{}peak\PYGZus{}index}
        \PYG{n}{current\PYGZus{}peak\PYGZus{}index} \PYG{o}{=} \PYG{n}{i}

        \PYG{k}{if} \PYG{n}{last\PYGZus{}peak\PYGZus{}index} \PYG{o}{\PYGZgt{}} \PYG{l+m+mi}{0}\PYG{p}{:} \PYG{c+c1}{\PYGZsh{} Ensure there are at least two beats before calculating heartrate}
            \PYG{n}{heartrate}\PYG{o}{.}\PYG{n}{append}\PYG{p}{(}\PYG{l+m+mi}{60} \PYG{o}{*} \PYG{n}{sample\PYGZus{}rate} \PYG{o}{/} \PYG{p}{(}\PYG{n}{current\PYGZus{}peak\PYGZus{}index} \PYG{o}{\PYGZhy{}} \PYG{n}{last\PYGZus{}peak\PYGZus{}index}\PYG{p}{))}

        \PYG{n}{cooldown} \PYG{o}{=} \PYG{n}{cooldown\PYGZus{}period}
\end{Verbatim}
